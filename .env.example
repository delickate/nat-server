# Domain (or subdomain) pointing at this server's public IP.
DOMAIN=remote.example.com

# docker-compose.proxy.yml only: local port the panel's reverse proxy targets.
# Change it if 8080 is already used on the server.
HOST_PORT=8080

# Optional tuning
MAX_CONNECTIONS=5000
REQUEST_TIMEOUT_SECS=60
RUST_LOG=nat_server=info
