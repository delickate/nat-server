# Alternative to Docker: run the binary directly with systemd.
#   sudo cp target/release/nat-server /usr/local/bin/
#   sudo cp deploy/nat-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nat-server
# Then put Nginx or Caddy in front of 127.0.0.1:8080 for HTTPS (see README).

[Unit]
Description=Delickate Remote Access rendezvous server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nat-server
Environment=BIND_ADDR=127.0.0.1:8080
Environment=RUST_LOG=nat_server=info
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
